# dapetin di https://aistudio.google.com/apikey (gratis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

MY_NAME=Muhammad Nabil
MY_ABSEN_NO=19

# true = cuma log, tidak kirim (buat tes awal)
DRY_RUN=true
# jeda anti-spam per grup (menit)
COOLDOWN_MIN=30

# Nomor WA bot, format 628xx tanpa + (buat pairing code, Railway tanpa layar)
PHONE_NUMBER=
# Path sesi Baileys. Di Railway isi /app/auth_info (mount Volume ke sana)
AUTH_DIR=auth_info
